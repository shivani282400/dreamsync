generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  createdAt      DateTime          @default(now())
  password       String
  username       String?           @unique
  usernameLocked Boolean           @default(false)
  dreams         Dream[]
  likes          Like[]
  comments       Comment[]
  insights       InsightSnapshot[]
}

model Dream {
  id             String            @id @default(uuid())
  userId         String
  content        String
  mood           String?
  tags           String[]
  createdAt      DateTime          @default(now())
  title          String?
  shareId        String?           @unique
  communityShare CommunityDream?
  likes          Like[]
  comments       Comment[]
  user           User              @relation(fields: [userId], references: [id])
  reflections    DreamReflection[]
  interpretation Interpretation?

  @@index([userId])
  @@index([createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  dreamId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dream Dream @relation(fields: [dreamId], references: [id], onDelete: Cascade)

  @@unique([userId, dreamId])
  @@index([dreamId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  dreamId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dream Dream @relation(fields: [dreamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dreamId])
}

model Interpretation {
  id        String   @id @default(uuid())
  dreamId   String   @unique
  createdAt DateTime @default(now())
  content   Json
  dream     Dream    @relation(fields: [dreamId], references: [id])
}

model DreamReflection {
  id        String   @id @default(uuid())
  dreamId   String
  question  String
  answer    String
  createdAt DateTime @default(now())
  dream     Dream    @relation(fields: [dreamId], references: [id])

  @@index([dreamId])
}

model InsightSnapshot {
  id        String      @id @default(uuid())
  userId    String
  period    String
  type      InsightType
  content   Json
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, period, type])
}

model CommunityDream {
  id              String   @id @default(uuid())
  originalDreamId String   @unique
  anonymizedText  String
  theme           String
  mood            String?
  tags            String[]
  createdAt       DateTime @default(now())
  dream           Dream    @relation(fields: [originalDreamId], references: [id])
}

enum InsightType {
  WEEKLY
  MONTHLY
}
